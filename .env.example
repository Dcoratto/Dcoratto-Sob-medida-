# Local app URL. In Render, use your public service URL after the first deploy.
APP_URL="http://localhost:3000"
VITE_APP_URL="http://localhost:3000"

# Render injects PORT automatically. Keep this only for local production tests.
PORT="3000"
NODE_ENV="development"

# Optional CORS allowlist for backend routes. Use comma-separated origins.
# For the normal Render single-service deploy, set this to the same value as APP_URL.
CORS_ORIGIN="http://localhost:3000"

# Supabase client configuration used by the Vite frontend at build time.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"

# Supabase server configuration used by backend routes such as /api/calendar-feed.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"

# Required only for backend routes/admin scripts that need privileged Supabase access.
# Do not expose this key in frontend code.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_SITE_URL="http://localhost:3000"

# Optional AI integration.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Server-only API key used to calculate quote delivery distance and duration.
